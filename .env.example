# Copiez ce fichier en `.env` à la racine du projet et renseignez vos valeurs.
# `.env` est ignoré par git : aucun secret réel ne doit être versionné.
# Chargement : `./run.ps1` (Windows) exporte ces variables avant de lancer Maven.

# Mot de passe du rôle PostgreSQL utilisé par l'application.
DB_PASSWORD=votre_mot_de_passe_postgres

# Clé de signature des JWT. Doit faire au moins 256 bits (32 caractères).
# Générez-en une : openssl rand -base64 48
JWT_SECRET=remplacez_par_une_cle_aleatoire_de_32_caracteres_minimum

# Emails des managers promus ADMIN (séparés par des virgules).
# Il n'existe pas de table Admin : le rôle est accordé au runtime sur cette liste.
# Doit contenir l'email du compte administrateur créé par la migration V3,
# sans quoi personne ne peut accéder à la page Administration.
ADMIN_EMAILS=admin@3s-sgi.local
